@model Mutex.Presentation.Models.Employees

<h2>Create Employee Record</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="EmpName"></label>
        <input asp-for="EmpName" class="form-control" />
        <span asp-validation-for="EmpName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EmpAge"></label>
        <input asp-for="EmpAge" class="form-control" />
        <span asp-validation-for="EmpAge" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EmpDept"></label>
        <select asp-for="EmpDept" class="form-select">
            <option value="">Select Department</option>
            <option>HR</option>
            <option>IT</option>
            <option>Finance</option>
            <option>Sales</option>
            <option>Operations</option>
        </select>
        <span asp-validation-for="EmpDept" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EmpDesignation"></label>
        <input asp-for="EmpDesignation" class="form-control" />
        <span asp-validation-for="EmpDesignation" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EmpSalary"></label>
        <input asp-for="EmpSalary" class="form-control" />
        <span asp-validation-for="EmpSalary" class="text-danger"></span>
    </div>


    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Show" class="btn btn-secondary">Back To Employee List</a>
    </div>
</form>
